<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Validators">
            <directory>packages/core/tests</directory>
            <directory>packages/sa/tests</directory>
            <directory>packages/eg/tests</directory>
            <directory>packages/ae/tests</directory>
            <directory>packages/laravel-sa/tests</directory>
            <directory>packages/laravel-eg/tests</directory>
            <directory>packages/laravel-ae/tests</directory>
            <directory>packages/codeigniter-sa/tests</directory>
            <directory>packages/codeigniter-eg/tests</directory>
            <directory>packages/codeigniter-ae/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>packages/core/src</directory>
            <directory>packages/sa/src</directory>
            <directory>packages/eg/src</directory>
            <directory>packages/ae/src</directory>
            <directory>packages/laravel-sa/src</directory>
            <directory>packages/laravel-eg/src</directory>
            <directory>packages/laravel-ae/src</directory>
            <directory>packages/codeigniter-sa/src</directory>
            <directory>packages/codeigniter-eg/src</directory>
            <directory>packages/codeigniter-ae/src</directory>
        </include>
    </source>
</phpunit>
