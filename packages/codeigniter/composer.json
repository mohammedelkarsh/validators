{
    "name": "validators/codeigniter",
    "description": "CodeIgniter 4 validation rules for country-specific validator packages.",
    "version": "1.0.1",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/mohammedelkarsh/validators",
    "support": {
        "issues": "https://github.com/mohammedelkarsh/validators/issues",
        "source": "https://github.com/mohammedelkarsh/validators"
    },
    "require": {
        "php": "^8.2",
        "validators/sa": "^1.0",
        "validators/eg": "^1.0",
        "validators/ae": "^1.0"
    },
    "autoload": {
        "psr-4": {
